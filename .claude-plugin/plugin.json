{
  "name": "ux-grandmaster",
  "displayName": "UX Grandmaster",
  "version": "1.1.0",
  "description": "A design methodology for AI agents: frame the problem, research, design with your system, get an independent critique, prove accessibility, then hand off.",
  "author": {
    "name": "Kemal Salih Carfi",
    "url": "https://kscarfi.com"
  },
  "homepage": "https://github.com/kscarfi/ux-grandmaster",
  "repository": "https://github.com/kscarfi/ux-grandmaster",
  "license": "MIT",
  "keywords": [
    "design",
    "ux",
    "ui",
    "accessibility",
    "research",
    "design-systems",
    "critique",
    "wcag"
  ],
  "hooks": "./.claude-plugin/hooks.json",
  "network": {
    "hosts": [
      "api.figma.com",
      "developer.apple.com",
      "developer.android.com",
      "m3.material.io",
      "developers.meta.com",
      "learn.microsoft.com",
      "fluent2.microsoft.design",
      "www.w3.org",
      "developer.mozilla.org",
      "web.dev",
      "docs.flutter.dev",
      "reactnative.dev",
      "www.nngroup.com",
      "baymard.com",
      "design-system.service.gov.uk",
      "registry.npmjs.org",
      "cdn.playwright.dev",
      "playwright.download.prss.microsoft.com"
    ]
  },
  "userConfig": {
    "library_path": {
      "type": "directory",
      "title": "Your design library (optional)",
      "description": "A folder of design books, papers and notes you own. UX Grandmaster indexes it on your machine and cites it by title and page. Nothing is uploaded or shared. Leave empty to skip."
    }
  }
}
